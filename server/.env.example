PORT=3001
AITUNNEL_API_KEY=
AITUNNEL_MODEL=claude-sonnet-4.5
AITUNNEL_QUIZ_MODEL=deepseek-v4-flash
AITUNNEL_EMBEDDING_MODEL=text-embedding-3-small
# Comma-separated list of allowed origins for the client (e.g. https://tutor.example.com).
# Leave unset or "*" to allow any origin.
CORS_ORIGIN=
# Tutor name shown in the header, and its directions separated by ";".
# Leave empty for the default tutor (Системная семейная терапия;КПТ).
TUTOR_TITLE=
DIRECTIONS=
